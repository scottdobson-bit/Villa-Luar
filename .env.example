# Admin password hash (SHA-256).
# Generate with: echo -n "your-new-password" | sha256sum
# Then set VITE_ADMIN_PASSWORD_HASH=<the hash> in your .env file or Cloudflare Pages env vars.
VITE_ADMIN_PASSWORD_HASH=e3b5bb054314c83c36f62926885156f41d55c20b1060e4456dab4c79f3ced83a

# Gemini API key for chatbot + AI image descriptions
API_KEY=your_gemini_api_key_here

# --- Remote Publish (Cloudflare KV) ---
# Secret key that authenticates content publish requests from the admin panel.
# Must match the CONTENT_API_KEY Worker secret set in the Cloudflare dashboard.
# Generate a strong random value: openssl rand -hex 32
VITE_CONTENT_API_KEY=your_secret_api_key_here

# Override the content API URL (optional). Defaults to /api/content.
# Set to an empty string to disable remote publish and use the bundled JSON only.
# VITE_CONTENT_API_URL=/api/content
