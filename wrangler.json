{
  "name": "billowing-union-e34a",
  "main": "worker.ts",
  "compatibility_date": "2024-11-23",
  "routes": [
    { "pattern": "villaluar.com/*", "zone_name": "villaluar.com" },
    { "pattern": "www.villaluar.com/*", "zone_name": "villaluar.com" }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "r2_buckets": [
    {
      "binding": "VILLA_LUAR_IMAGES",
      "bucket_name": "villa-luar-images"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "VILLA_CONTENT",
      "id": "09868a9ddd57433eb24cd4c1db97630f"
    }
  ],
  "observability": {
    "enabled": true
  }
}
